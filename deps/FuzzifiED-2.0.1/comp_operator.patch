+function _CompAssemblyForEach(f, nwork :: Int64, num_th :: Int64)
+    nworkers = min(max(1, num_th), nwork)
+    next_work = Threads.Atomic{Int64}(0)
+    @sync for _ = 1 : nworkers
+        Threads.@spawn begin
+            while true
+                iwork = Threads.atomic_add!(next_work, 1) + 1
+                iwork > nwork && break
+                f(iwork)
+            end
+        end
+    end
+    return nworkers
+end
