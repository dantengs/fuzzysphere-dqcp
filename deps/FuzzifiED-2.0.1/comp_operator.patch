+# Typed boundary for the repeated contraction/accumulation kernel. The outer
+# task still exclusively owns irng, and scratch/scr2 remain task-private.
+# Views are created and consumed within this concrete kernel; no broadcast
+# expression or view wrapper escapes the hot outer channel loop.
+function _CompKronAccumulate!(stf::Vector{T}, irng::UnitRange{Int64},
+                              scratch::Vector{T}, blocks::Vector{Matrix{T}},
+                              std::Vector{T}, jrng::UnitRange{Int64},
+                              scr2::Vector{T}, factor::T) where T
+    tmp = @view scratch[1:length(irng)]
+    _KronMul!(tmp, blocks, (@view std[jrng]), scr2)
+    offset = first(irng) - 1
+    @inbounds for i in eachindex(irng)
+        stf[offset+i] += factor * scratch[i]
+    end
+    return nothing
+end
